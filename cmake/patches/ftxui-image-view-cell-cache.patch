+// Cache key / value for an image's finished cells at one size.
+struct CellsKey {
+    uint64_t url_hash;
+    uint64_t version;
+    uint16_t width;
+    uint16_t height;
+    bool operator==(const CellsKey& o) const {
+        return url_hash == o.url_hash && version == o.version && width == o.width && height == o.height;
+    }
+};
+struct CellsKeyHash {
+    size_t operator()(const CellsKey& k) const {
+        std::size_t seed = std::hash<uint64_t>{}(k.url_hash);
+        hash_combine(seed, k.version);
+        hash_combine(seed, k.width);
+        hash_combine(seed, k.height);
+        return seed;
+    }
+};
+struct CellGrid {
+    int rows = 0, cols = 0;
+    std::vector<ftxui::Cell> cells;
+};
